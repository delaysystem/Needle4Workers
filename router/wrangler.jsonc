{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "needle-router",
	"main": "index.ts",
	"compatibility_date": "2026-09-21",
	"vars": {
		"ROUTE_POLICY": "single-20",
		"BACKEND_20L_URL": "https://needle.emalteaproductions.workers.dev"
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": true },
		"traces": { "enabled": true }
	},
	"upload_source_maps": true
}
